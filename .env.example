# HookSentry Environment Variables
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hooksentry"

# Clerk Authentication (Get these from dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/endpoints"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/endpoints"
